            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.2 }}>条使用要点</Text>
                <Text style={{ fontSize: 20, color: 'rgba(30,58,138,0.7)', lineHeight: 1.5 }}>先自己想 · 再让 AI 拓展 · 最后人工核验</Text>
            </Box>
        </Box>
        <Box style={{ height: 18 }} />
        <Box style={{ width: 940, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'flex-start' }}>
                <Box style={{
                    width: 44,
                    height: 44,
                    borderRadius: 22,
                    background: '#2563EB',
                    justifyContent: 'center',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F4F7FF' }}>读</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.4 }}>先读后筛，再回原文核对</Text>
                    <Text style={{ fontSize: 18, color: '#111827', lineHeight: 1.5 }}>长文档助手帮你快速判断重点，但真正的理解必须回原文自己完成。</Text>
                </Box>
            </Box>
            <Box style={{ height: 18 }} />
            <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'flex-start' }}>
                <Box style={{
                    width: 44,
                    height: 44,
                    borderRadius: 22,
                    background: '#2563EB',
                    justifyContent: 'center',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F4F7FF' }}>写</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.4 }}>先搭框架，再让 AI 扩写</Text>
                    <Text style={{ fontSize: 18, color: '#111827', lineHeight: 1.5 }}>写作与代码交给助手提速，但立意、结构与结论由你拍板。</Text>
                </Box>
            </Box>
            <Box style={{ height: 18 }} />
            <Box style={{ flexDirection: 'row', gap: 18, alignItems: 'flex-start' }}>
                <Box style={{
                    width: 44,
                    height: 44,
                    borderRadius: 22,
                    background: '#2563EB',
                    justifyContent: 'center',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F4F7FF' }}>做</Text>
