<Slide style={{
    width: '1280px',
    height: '720px',
    background: '#F4F7FF',
    padding: '24px 64px',
    flexDirection: 'column',
}}>
    <Box style={{ height: 96, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 44, background: '#2563EB' }} />
        <Box style={{ flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.25 }}>工具二 · 通用写作与答疑助手</Text>
            <Text style={{ fontSize: 15, color: 'rgba(30,58,138,0.65)', lineHeight: 1.5 }}>代表工具：DeepSeek · ChatGPT · 文心一言</Text>
        </Box>
    </Box>
    <Box style={{ height: 516, flexDirection: 'column', gap: 16 }}>
        <Box style={{
            height: 84,
            background: 'rgba(37,99,235,0.10)',
            borderLeft: '4px solid #2563EB',
            borderRadius: 14,
            padding: '0 24px',
            flexDirection: 'row',
            alignItems: 'center',
            gap: 16,
        }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2563EB', lineHeight: 1.4 }}>一句话定位</Text>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.45 }}>随身「第二大脑」——写作与答疑的效率搭子</Text>
            <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#2563EB', lineHeight: 1.4 }}>上手难度</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 2 }}>
                    <Text style={{ fontSize: 16, color: '#2563EB', lineHeight: 1.4 }}>★★</Text>
                    <Text style={{ fontSize: 16, color: 'rgba(37,99,235,0.28)', lineHeight: 1.4 }}>★</Text>
                </Box>
                <Text style={{ fontSize: 14, color: 'rgba(30,58,138,0.6)', lineHeight: 1.4 }}>需一点提示词技巧</Text>
            </Box>
        </Box>
        <Box style={{ height: 416, flexDirection: 'row', gap: 24 }}>
            <Box style={{
                width: 664,
                height: 416,
                background: '#FFFFFF',
                border: '1px solid rgba(37,99,235,0.22)',
                borderRadius: 14,
                padding: '20px 24px',
                flexDirection: 'column',
            }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2563EB', lineHeight: 1.4 }}>3 个核心功能</Text>
                <Box style={{ height: 16 }} />
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name='comments' style={{ fill: '#2563EB', width: 22, height: 22 }} />
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.4 }}>对话答疑</Text>
                        <Text style={{ fontSize: 16, color: '#111827', lineHeight: 1.5 }}>多轮追问把模糊问题逼到具体，还能指定角色扮演面试官、审稿人</Text>
                    </Box>
                </Box>
                <Box style={{ height: 14 }} />
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name='pencil-alt' style={{ fill: '#2563EB', width: 22, height: 22 }} />
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.4 }}>写作润色</Text>
                        <Text style={{ fontSize: 16, color: '#111827', lineHeight: 1.5 }}>论文、报告与英文作文的起草、扩写与语言润色，先给一版能改的初稿</Text>
                    </Box>
                </Box>
                <Box style={{ height: 14 }} />
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <FAIcon name='code' style={{ fill: '#2563EB', width: 22, height: 22 }} />
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E3A8A', lineHeight: 1.4 }}>代码调试</Text>
                        <Text style={{ fontSize: 16, color: '#111827', lineHeight: 1.5 }}>定位报错原因、解释代码逻辑，给出可运行的修改方案</Text>
                    </Box>
                </Box>
            </Box>
            <Box style={{
                width: 464,
                height: 416,
                position: 'relative',
                borderRadius: 16,
                overflow: 'hidden',
                background: '#FFFFFF',
            }}>
                <Image
                    src='assets/tool2_writing.png'
                    style={{ width: 464, height: 416, objectFit: 'cover' }}
                />
                <Box style={{
                    position: 'absolute',
                    left: 14,
                    right: 14,
                    bottom: 14,
                    background: 'rgba(255,255,255,0.94)',
                    borderRadius: 12,
                    padding: '12px 16px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#2563EB', lineHeight: 1.4 }}>适用场景</Text>
                    <Box style={{ height: 4 }} />
                    <Text style={{ fontSize: 15, color: '#111827', lineHeight: 1.5 }}>代码报错找不到原因 · 英语作文找人批改 · 答辩前模拟被提问</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: 'rgba(30,58,138,0.45)' }}>大学生必备AI工具使用指南</Text>
        <Text style={{ fontSize: 14, color: 'rgba(30,58,138,0.45)' }}>03 / 05</Text>
    </Box>
</Slide>
