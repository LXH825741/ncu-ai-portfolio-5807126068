                <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.7)', lineHeight: 1.4 }}>需练习提示词与审美</Text>
            </Box>
            <Box style={{ flex: 1 }} />
            <Box style={{ width: 68, height: 2, background: 'rgba(255,255,255,0.35)' }} />
            <Box style={{ height: 18 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: 'rgba(255,255,255,0.65)', lineHeight: 1.4 }}>适用场景</Text>
            <Box style={{ height: 10 }} />
