            <Box style={{ height: 14 }} />
            <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.82)', lineHeight: 1.55 }}>把一句话想法，直接变成能展示的成品</Text>
            <Box style={{ height: 16 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
