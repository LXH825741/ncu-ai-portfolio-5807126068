                <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.92)' }}>社团招新与活动海报</Text>
            </Box>
            <Box style={{ height: 8 }} />
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
